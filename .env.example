# ===============================================
# SitePulse AI - Environment Configuration
# ===============================================

# Google Gemini API Key (Required for live AI analysis)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_api_key_here

# Supported Gemini Model (Default: gemini-3.5-flash, gemini-2.5-flash, or gemini-1.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Server Network Configuration
HOST=0.0.0.0
PORT=4000
ENVIRONMENT=development

# Extraction & Scraping Engine Limits
REQUEST_TIMEOUT_SECONDS=15.0
MAX_CONTENT_LENGTH=5242880
MAX_REDIRECTS=5
MAX_SUBPAGES_TO_CRAWL=2
MAX_EXTRACTED_CHARS=25000

# TTL Cache Configuration (in seconds; 3600 = 1 hour)
CACHE_TTL_SECONDS=3600

# Optional External Search Provider for Verified Competitor Research
# If left blank, AI-generated unverified competitor profiles are returned with clear labels
TAVILY_API_KEY=
SEARCH_API_KEY=
